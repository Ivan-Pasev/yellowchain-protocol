{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowchain.org/protocol/0.1/schemas/issuer/split-view.synthetic.schema.json",
  "title": "YC-47 verified synthetic conflicting checkpoint observation",
  "description": "Wire shape only. Both histories and signed checkpoints must be independently verified under the same retained predecessor and pinned trust epoch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "origin",
    "sequence",
    "predecessor_digest",
    "left_checkpoint_digest",
    "right_checkpoint_digest",
    "left",
    "right",
    "observed_at",
    "boundary",
    "public_claim_allowed",
    "agent_action_allowed"
  ],
  "properties": {
    "version": {
      "const": "yc-split-view/0.1.0"
    },
    "origin": {
      "const": "synthetic:yellowchain:BG:issuer-registry"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "left_checkpoint_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "right_checkpoint_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "left": {
      "$ref": "#/$defs/view"
    },
    "right": {
      "$ref": "#/$defs/view"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "boundary": {
      "const": "synthetic-split-view-not-public-issuance"
    },
    "public_claim_allowed": {
      "const": false
    },
    "agent_action_allowed": {
      "const": false
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "history"
      ],
      "properties": {
        "checkpoint": {
          "$ref": "https://yellowchain.org/protocol/0.1/schemas/issuer/checkpoint.synthetic.schema.json"
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://yellowchain.org/protocol/0.1/schemas/lifecycle-event.synthetic.schema.json"
          }
        }
      }
    }
  }
}
