{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowchain.org/protocol/0.1/schemas/issuer/checkpoint.synthetic.schema.json",
  "title": "YC-45 signed synthetic issuer-registry checkpoint (shape only)",
  "description": "Shape validation only. Signatures, independent keys, quorum, freshness, and full-history replay MUST be validated by a runtime. Not an RFC 9162 Merkle checkpoint or public credential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "origin",
    "sequence",
    "event_head_hash",
    "state_hash",
    "previous_checkpoint_digest",
    "issued_at",
    "log_signature_b64url",
    "witness_signatures"
  ],
  "properties": {
    "version": {
      "const": "yc-checkpoint/0.1.0"
    },
    "origin": {
      "const": "synthetic:yellowchain:BG:issuer-registry"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_head_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_checkpoint_digest": {
      "type": "string",
      "pattern": "^(GENESIS|[a-f0-9]{64})$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "log_signature_b64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "witness_signatures": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "witness_id",
          "signature_b64url"
        ],
        "properties": {
          "witness_id": {
            "type": "string",
            "pattern": "^synthetic:witness:[A-Za-z0-9_-]+$"
          },
          "signature_b64url": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    }
  }
}
