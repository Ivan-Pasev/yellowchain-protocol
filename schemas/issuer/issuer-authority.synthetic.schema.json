{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowchain.org/protocol/0.1/schemas/issuer-authority.synthetic.schema.json",
  "title": "YC-43 synthetic trusted issuer authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "synthetic",
    "issuer_id",
    "jurisdiction",
    "policy_version",
    "approved_tiers",
    "approved_claim_scopes",
    "public_key_pem",
    "effective_at",
    "expires_at",
    "state",
    "registry_event_id"
  ],
  "properties": {
    "synthetic": {
      "const": true
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "const": "BG"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "approved_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "YC-1",
          "YC-2",
          "YC-3",
          "YC-4"
        ]
      }
    },
    "approved_claim_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "public_key_pem": {
      "type": "string",
      "pattern": "^-----BEGIN PUBLIC KEY-----"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "active",
        "suspended",
        "revoked"
      ]
    },
    "registry_event_id": {
      "type": "string",
      "pattern": "^synthetic:"
    }
  }
}
