{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowchain.org/protocol/0.1/schemas/geo/merchant-pin.synthetic.schema.json",
  "title": "YC-50 offline merchant-signing-key pin (synthetic only)",
  "description": "Out-of-band authorization reference cannot establish legal merchant or website authority without independent human verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business_id",
    "merchant_key_id",
    "merchant_public_key_pem",
    "key_fingerprint",
    "authorization_ref"
  ],
  "properties": {
    "business_id": {
      "type": "string",
      "pattern": "^yc:business:BG:[A-Za-z0-9_-]{3,128}$"
    },
    "merchant_key_id": {
      "type": "string",
      "pattern": "^synthetic:owner:[A-Za-z0-9_-]+$"
    },
    "merchant_public_key_pem": {
      "type": "string",
      "minLength": 20
    },
    "key_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_ref": {
      "type": "string",
      "pattern": "^synthetic:offline-owner-approved:[A-Za-z0-9_-]+$"
    }
  }
}
