{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowchain.org/protocol/0.1/schemas/geo/readiness-receipt.synthetic.schema.json",
  "title": "YC-49 synthetic GEO readiness receipt with explicit evidence limits",
  "description": "Counts are diagnostic signals, not a ranking score, indexing guarantee, GEO certificate or proof of owner authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "boundary",
    "jurisdiction",
    "business_id",
    "snapshot_observed_at",
    "measured",
    "signals",
    "authorization_verified",
    "external_crawl_verified",
    "ai_citation_verified",
    "organic_placement_guaranteed",
    "public_claim_allowed",
    "agent_action_allowed"
  ],
  "properties": {
    "version": {
      "const": "yc-geo-readiness/0.1.0"
    },
    "boundary": {
      "const": "synthetic-diagnostic-not-search-placement"
    },
    "jurisdiction": {
      "const": "BG"
    },
    "business_id": {
      "type": "string",
      "pattern": "^yc:business:BG:[A-Za-z0-9_-]{3,128}$"
    },
    "snapshot_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "blocked",
        "review",
        "unknown"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "status": {
            "enum": [
              "pass",
              "blocked",
              "review",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authorization_verified": {
      "const": false
    },
    "external_crawl_verified": {
      "const": false
    },
    "ai_citation_verified": {
      "const": false
    },
    "organic_placement_guaranteed": {
      "const": false
    },
    "public_claim_allowed": {
      "const": false
    },
    "agent_action_allowed": {
      "const": false
    }
  }
}
