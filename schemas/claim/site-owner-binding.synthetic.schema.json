{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yellowchain.org/protocol/0.1/schemas/claim/site-owner-binding.synthetic.schema.json",
  "title": "YC51 synthetic two-proof state",
  "description": "Pure revisioned state; production atomic CAS and legal verification are NOT provided.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "boundary",
    "challenge_id",
    "tenant_id",
    "business_id",
    "jurisdiction",
    "hostname",
    "challenge_secret_digest",
    "issued_at",
    "expires_at",
    "status",
    "revision",
    "site_observation_digest",
    "site_observer_fingerprint",
    "site_observed_at",
    "business_review_digest",
    "reviewer_fingerprint",
    "business_reviewed_at",
    "operator_ownership_verified",
    "public_claim_allowed",
    "agent_action_allowed"
  ],
  "properties": {
    "version": {
      "const": "yc-site-owner-binding/0.1.0"
    },
    "boundary": {
      "const": "synthetic-two-proof-not-legal-ownership"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^synthetic:tenant:[A-Za-z0-9_-]{3,80}$"
    },
    "business_id": {
      "type": "string",
      "pattern": "^yc:business:BG:[A-Za-z0-9_-]{3,128}$"
    },
    "hostname": {
      "type": "string",
      "pattern": "(^|\\.)(example|test)$",
      "maxLength": 253
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "jurisdiction": {
      "const": "BG"
    },
    "challenge_secret_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pending",
        "control_observed_synthetic",
        "bound_synthetic_only"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "site_observation_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "site_observer_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "site_observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "business_review_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "business_reviewed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "operator_ownership_verified": {
      "const": false
    },
    "public_claim_allowed": {
      "const": false
    },
    "agent_action_allowed": {
      "const": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "pending"
        },
        "revision": {
          "const": 0
        },
        "site_observation_digest": {
          "type": "null"
        },
        "site_observer_fingerprint": {
          "type": "null"
        },
        "site_observed_at": {
          "type": "null"
        },
        "business_review_digest": {
          "type": "null"
        },
        "reviewer_fingerprint": {
          "type": "null"
        },
        "business_reviewed_at": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "control_observed_synthetic"
        },
        "revision": {
          "const": 1
        },
        "site_observation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "site_observer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "site_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "business_review_digest": {
          "type": "null"
        },
        "reviewer_fingerprint": {
          "type": "null"
        },
        "business_reviewed_at": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "bound_synthetic_only"
        },
        "revision": {
          "const": 2
        },
        "site_observation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "site_observer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "site_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "business_review_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "business_reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  ]
}
